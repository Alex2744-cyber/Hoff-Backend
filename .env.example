# Copiar a .env y rellenar. No subir .env al repositorio.
#
# Desarrollo en tu PC (recomendado para `expo start` + API local):
# NODE_ENV=development
# En desarrollo CORS permite cualquier origen (Expo web en :8081, etc.).
#
# --- Backend local + MySQL en Railway (host/puerto PUBLICOS del panel MySQL) ---
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=railway
# Obligatorio si el host no es *.railway / *.rlwy.net (MySQL local sin SSL):
# DB_SSL=false
# Con Railway en la nube suele activarse solo al detectar el host; puedes forzar:
# DB_SSL=true

PORT=3000

# --- Seguridad HTTP / CORS ---
# En producción define todos los orígenes web permitidos, separados por coma y SIN "/" final.
# Ejemplo:
# ALLOWED_ORIGINS=https://app.tudominio.com,https://www.tudominio.com
# Nota: apps nativas y herramientas como curl/Postman suelen no enviar Origin y siguen permitidas.
# ALLOWED_ORIGINS=
#
# Límite global de requests por IP cada 15 min (default 600).
# RATE_LIMIT_GLOBAL_MAX=600
#
# Límite de subidas /api/media/upload por IP cada 15 min (default 60).
# RATE_LIMIT_UPLOAD_MAX=60

# --- Subida de imágenes (Hostinger / VPS) ---
# Carpeta persistente en el servidor donde se guardan los ficheros (recomendado en producción).
# Si no se define, se usa la carpeta ./uploads en la raíz del backend.
# UPLOADS_DIR=/var/www/hoff/uploads
#
# URL pública base SIN barra final (HTTPS del dominio que sirve la API y /uploads).
# Imprescindible detrás de Nginx/proxy si req.protocol no es fiable.
# PUBLIC_BASE_URL=https://api.tudominio.com
#
# Tamaño máximo por archivo en MB (por defecto 5).
# MAX_UPLOAD_MB=5

# Firma de JWT (obligatorio en producción). Genera una cadena larga y aleatoria.
# Postman/scripts: tras POST /api/auth/login, enviar Authorization: Bearer <token> en el resto de rutas.
JWT_SECRET=

# --- MySQL solo en tu PC (sin Railway) ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_PASSWORD=tu_clave_local
# DB_NAME=cleaning_app
# DB_SSL=false
